{
  "name": "@mocode/runtime",
  "version": "0.1.0",
  "description": "Stable host launch and NDJSON client boundary for Mocode applications.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host-client.d.ts",
      "default": "./dist/host-client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:electron-boundary": "node scripts/check-electron-boundary.mjs",
    "smoke:host": "node scripts/host-smoke.mjs"
  },
  "dependencies": {
    "@mocode/protocol": "0.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
