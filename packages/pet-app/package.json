{
  "name": "mocode-pet-app",
  "version": "0.1.0",
  "description": "mocode 桌宠:独立 Electron 悬浮窗,展示 agent 执行状态动画。作为 mocode-ai 的可选子包,不随主包安装强制拉取。",
  "private": false,
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "mocode-pet-app": "bin/pet-app.js"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "electron dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "43.0.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/ws": "8.5.13",
    "typescript": "5.7.2"
  },
  "author": "wxy",
  "license": "MIT"
}
