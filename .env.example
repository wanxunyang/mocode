# mocode 配置可放在以下任一处(优先级:shell 环境变量 > <cwd>/.env 或 <cwd>/.mocode/config > ~/.mocode/config):
#   全局(推荐,任意目录 / 任意终端生效):~/.mocode/config   ← 用 `mocode config` 交互生成
#   项目级(仅当前目录生效):<cwd>/.env 或 <cwd>/.mocode/config
# 本文件是项目级 .env 的模板;整份复制到 ~/.mocode/config 即全局生效。
#
# ===== LLM 后端配置(OpenAI 兼容接口)=====
# 常见后端 base_url:
#   GLM(智谱):     https://open.bigmodel.cn/api/v3
#   DeepSeek:       https://api.deepseek.com
#   Qwen(阿里):     https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama:    http://localhost:11434/v1
#   本地 vLLM:      http://localhost:8000/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/v3

# 你的 API key
LLM_API_KEY=your-key-here

# 模型名(按你选的后端填)
LLM_MODEL=glm-5.2

# 可选:单次回复最大 token
# MAX_TOKENS=4096

# ===== 上下文工程(自动压缩 / 会话落盘)=====
# 模型上下文窗口(token)。须对齐真实模型窗口,否则压缩触发时机会偏:
#   GLM-4.6 ≈ 128000 · DeepSeek-V3 ≈ 64000 · Qwen2.5 视版本 32000~128000
# CONTEXT_WINDOW_TOKENS=128000

# 自动压缩触发阈值(占窗口比例,0~1)。默认 0.85,保守偏早以吸收估算误差。
# COMPACT_THRESHOLD=0.85

# 流式请求带 stream_options.include_usage 拿真实 token 用量(/context 显示"实测")。
# 后端不认 stream_options 报 400 时设为 false,改用启发式估算。
# LLM_STREAM_USAGE=true

# 自动压缩总开关。设为 false 则只靠手动 /compact。
# AUTO_COMPACT=true

# 代码变更后的任务收尾自动验证。默认 true；设为 false 可回退到模型主动运行验证。
# MOCODE_AUTO_VALIDATE=true

# Context Optimization Pipeline 总开关:工具结果进 LLM 前按数据类型编码(glob→树、grep→分组搜索、
# run_command→日志折叠、memory→卡片…),减 token 且不丢信息。未注册 encoder 时回落原样(零行为变化)。
# Phase 1 仅落地骨架 + passthrough 兜底,行为与关掉时逐字节一致;Phase 2 起逐步启用各 encoder。
# 设为 false 可紧急全量回退到"仅长度裁剪"的老路径。
# MOCODE_CONTEXT_OPTIMIZE=true

# Observer-tool lifecycle compression (grep/glob/codegraph/web_search/web_fetch).
# Enabled by default; set to false to disable cross-turn aging and digests.
# MOCODE_LIFECYCLE=false

# ===== 后台反思(跨会话记忆)=====
# 后台反思 pass 总开关。关掉则只靠手动 /reflect + 机会主义 memory_update。
# AUTO_REFLECT=true
# 每 N 个轮次触发一次后台反思 pass(与 agent 并发,不阻塞)。默认 5。
# REFLECT_EVERY_N=5

# 每轮 agent 循环最大步数(防无限循环,LLM 工具调用轮数上限)。默认 200。
# 任务复杂、需要更多工具调用时调大;为省 token/防止失控时调小。
# MAX_STEPS=1000

# 子 Agent 总开关。默认关闭；可在 TUI 用 /subagent on|off|status 即时切换。
# MOCODE_SUBAGENT_ENABLED=false

# 子 agent 默认与主 Agent 使用相同步数上限，仅用于防止无限循环；需要时可单独覆盖。默认 200。
# SUB_AGENT_MAX_STEPS=1000

# ===== 联网搜索(AnySearch,可选)=====
# 不配 ANYSEARCH_API_KEY 也能用:走匿名模式(按 IP 限流 + 每日免费额度)。
# 配了 key 用付费额度、更高并发;key 非法会直接 401(不降级匿名)。
# 控制台创建 key:https://www.anysearch.com/console/api-keys
# ANYSEARCH_API_KEY=your-anysearch-key
# ANYSEARCH_BASE_URL=https://api.anysearch.com

# ===== Skills(按需加载,可选)=====
# mocode 自动扫描以下目录的 skill(每个 skill 是 <name>/SKILL.md,带 frontmatter):
#   ~/.claude/skills/、~/.mocode/skills/、<cwd>/.mocode/skills/
# 设了 SKILLS_DIRS 则覆盖默认三目录(按平台 PATH 分隔:Windows 用 ;,POSIX 用 :)。
# skill 的 description 注入系统提示,模型按需调 use_skill 工具加载正文。
# SKILLS_DIRS=C:\Users\you\.claude\skills;./.mocode/skills

# ===== 界面语言与颜色主题(可选)=====
# 支持 zh-CN / en；未设置时根据系统语言检测，运行中可用 /language 即时切换并持久化。
# shell 环境变量优先级高于配置文件。
# MOCODE_LANGUAGE=zh-CN

# 内建主题:default(16 色原版,深底)、light(浅底终端)、solarized、gruvbox、nord。
# 运行中用 /theme 命令交互切换(选菜单或 /theme <名称>)——即时全屏重绘,并写入此文件,下次启动生效。
# 也可在此手填。shell 环境变量 MOCODE_THEME 优先级高于文件(设了则 /theme 写文件时给提示)。
# MOCODE_THEME=default

# ===== 沙箱(可选)=====
# 沙箱根目录:agent 文件操作(read_file/write_file/edit_file/glob/grep)与 run_command 的 cwd 边界。
# 默认 process.cwd()。越界路径(../、绝对外圈、符号链接出圈)被拒;memory_*/use_skill 在外圈豁免。
# run_command 的绝对路径写不被纯 JS 层挡(需 OS jailer,默认不启用);仅挡灾难命令(rm -rf / 等)。
# 优先级:--sandbox-root <path> 命令行 > SANDBOX_ROOT env > process.cwd()。
# SANDBOX_ROOT=/path/to/project

# ===== Model Context Protocol (MCP，可选) =====
# MCP_SERVERS 是 JSON，支持同时挂多个本地或线上 server。敏感 token 建议用 ${ENV_VAR} 引用 shell 环境变量，
# 不要把 token 明文提交到 .env。也可将同样 JSON 放在单独文件，并设置 MCP_CONFIG_PATH=./mcp.servers.json。
# transport: stdio（本地进程）、streamable-http（现代远程 MCP，默认）、sse（旧版 HTTP+SSE）。
# 本地 stdio server 运行任意命令，远程 MCP 工具也可能产生副作用；mocode 会为每次外部工具调用弹出授权。
# MCP_SERVERS={"mcpServers":{"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."],"requestTimeoutMs":30000},"github":{"transport":"streamable-http","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ${GITHUB_MCP_TOKEN}"}},"legacy":{"transport":"sse","url":"https://example.com/sse"}}}
# MCP_CONFIG_PATH=./mcp.servers.json
