# mocode 配置可放在以下任一处(优先级:shell 环境变量 > <cwd>/.env 或 <cwd>/.mocode/config > ~/.mocode/config):
#   全局(推荐,任意目录 / 任意终端生效):~/.mocode/config   ← 用 `mocode config` 交互生成
#   项目级(仅当前目录生效):<cwd>/.env 或 <cwd>/.mocode/config
# 本文件是项目级 .env 的模板;整份复制到 ~/.mocode/config 即全局生效。
#
# ===== LLM 后端配置(OpenAI 兼容接口)=====
# 常见后端 base_url:
#   GLM(智谱):     https://open.bigmodel.cn/api/v3
#   DeepSeek:       https://api.deepseek.com
#   Qwen(阿里):     https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama:    http://localhost:11434/v1
#   本地 vLLM:      http://localhost:8000/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/v3

# 你的 API key
LLM_API_KEY=your-key-here

# 模型名(按你选的后端填)
LLM_MODEL=glm-5.2

# 可选:单次回复最大 token
# MAX_TOKENS=4096

# ===== 上下文工程(自动压缩 / 会话落盘)=====
# 模型上下文窗口(token)。全局默认 256000；provider 不同时可显式覆盖。
# CONTEXT_WINDOW_TOKENS=256000

# 自动 pressure 清理与历史压缩共用固定 80% 触发线，不再分别配置阈值。
# 达到后由 scheduler 一次性执行清理并继续 compact，以节省 token。

# 流式请求带 stream_options.include_usage 拿真实 token 用量(/context 显示"实测")。
# 后端不认 stream_options 报 400 时设为 false,改用启发式估算。
# LLM_STREAM_USAGE=true

# 自动压缩总开关。设为 false 则只靠手动 /compact。
# AUTO_COMPACT=true

# Typed encoder 由统一 pressure scheduler 调用：总上下文达到 80% 时处理 Cold 区
# 的旧日志/搜索结果，并继续 compact。默认开启；正常工具结果原样进入 history，仅保留单条 hard cap。
# 设 false 可关闭该阶段。
# MOCODE_CONTEXT_OPTIMIZE=true

# 精确 superseded 裁剪同样只由统一的 80% pressure 事件调用：同 path 旧 read、
# mutation 前旧 read、完全相同 grep 可被存根。默认开启；设 false 可关闭。
# MOCODE_CONTEXT_RELPRUNE=true

# Lifecycle 默认只维护 LIVE/REFERENCED 等 provenance metadata，不按工具调用次数老化、
# STUB 或 DIGEST，也不改写正文。设 false 可连 metadata tracking 一并关闭。
# MOCODE_LIFECYCLE=true

# 五区预算与真实 pressure 调度默认开启；关闭后仍保留接近 provider limit 的基础 compact 保护。
# MOCODE_BUDGET_SCHEDULER=true

# ===== 后台反思(跨会话记忆)=====
# 后台反思默认关闭；如需定期从会话挖掘记忆，显式设为 true。
# AUTO_REFLECT=false
# 每 N 个轮次触发一次后台反思 pass(与 agent 并发,不阻塞)。默认 5。
# REFLECT_EVERY_N=5

# 每轮 agent 循环最大步数(防无限循环,LLM 工具调用轮数上限)。默认 200。
# 任务复杂、需要更多工具调用时调大;为省 token/防止失控时调小。
# MAX_STEPS=1000

# ===== 自动工具路由 capability gates =====
# 每个真实用户 turn 都由 LLM 按需选择工具簇。以下开关只有显式小写 false 才是硬否决；
# 未设置或 true 只表示“允许被路由”，不会把工具常驻加入每次请求的 schema。
# /subagent、/fe、/cu 是这些 gate 的兼容 TUI 控制入口。
# MOCODE_SUBAGENT_ENABLED=false
# MOCODE_FRONTEND_TOOLS_ENABLED=false
# MOCODE_COMPUTER_USE_ENABLED=false
# MEMORY_ENABLED=false

# ===== 工具预路由后端(/router)=====
# 总开关:设为 false 关闭预路由——每个 turn 不再发起路由调用,仅保留默认工具簇
# (常驻簇 + 通用工具,默认簇构成后续可调)。默认开启;亦可用 /router on|off 即时切换。
# MOCODE_ROUTER_ENABLED=false
#
# 每个真实用户 turn 的预路由由哪个后端完成。默认 llm（与主 Agent 同一后端，零额外依赖）。
# 设为 jev 时改用 TypeSafe systemone API：每组独立返回 0~1 概率，可按阈值调误报/漏报权衡，
# 且延迟远低于 LLM（实测 0.4~1s vs ~6s），但准确率低于 LLM（100 用例实测 85/97 vs 94/97）。
# 适合「要低延迟 / 要把路由与主模型解耦」的场景；主回调兜底路径始终保留。
# MOCODE_ROUTER_MODE=jev
#
# Jev 端点基址。官方 https://api.typesafe.ai；本地部署兼容层（如 0xBakeer/arbiter）
# 可直接指向 http://localhost:8010，协议一致、只换 baseURL。
# MOCODE_ROUTER_JEV_BASE_URL=https://api.typesafe.ai
# Jev API key（在 https://typesafe.ai 申请）。未设置时 jev 模式直接降级，不发请求。
# MOCODE_ROUTER_JEV_API_KEY=your-jev-key
# 模型名，默认 jev-latest。
# MOCODE_ROUTER_JEV_MODEL=jev-latest
#
# 出簇阈值：概率 ≥ 阈值才激活该簇。默认 0.65（100 用例实测最佳 operating point）。
# mcp 单独用更高门槛（默认 0.85）：实测它是系统性假阳性磁铁，对无关任务也给 0.5~0.7。
# MOCODE_ROUTER_CONFIDENCE_MIN=0.65
# MOCODE_ROUTER_CONFIDENCE_MIN_MCP=0.85

# 子 agent 默认与主 Agent 使用相同步数上限，仅用于防止无限循环；需要时可单独覆盖。默认 1000。
# SUB_AGENT_MAX_STEPS=1000

# 同一轮内派发的多个子 agent 的并发上限（≥1）。>1 时它们真正并行，墙钟由 Σ 压到 ≈max；
# 设 1 即退化为逐个串行。并发会瞬时放大对后端的请求量，触限流时调小。默认 5。
# SUB_AGENT_CONCURRENCY=5

# ===== Computer Use 调优(可选,需先 MOCODE_COMPUTER_USE_ENABLED=true)=====
# 抓屏与输入注入是两个常驻 PowerShell 进程:第一次用到才起(不因 /cu on 就起),
# 空闲自动回收,关开关与退出时强制回收。实测常驻命中比冷启动快约 11 倍。
#
# 喂模型的截图长边像素上限。默认 1568(视觉模型原生分辨率,低于它小字/密集 UI 定位会糊)。
# 调大更清晰但 token 与编码耗时上升;调小更省但精度下降。合法区间 256-4096。
# MOCODE_CU_MAX_EDGE=1568
#
# 帧间差异低于此比例就认为"屏幕没变",跳过回灌截图(省 token 与上传)。默认 0.005(0.5%),
# 足以吃掉抗锯齿/光标抖动,又不会漏掉真实重绘。设 0 关闭去重(每步都回灌)。
# MOCODE_CU_DIFF_THRESHOLD=0.005
#
# 常驻进程空闲多久自动回收(毫秒)。默认 180000(3 分钟)。设 0 表示只靠 /cu off 与退出回收。
# 注意:清空这个变量(留空串)等于用默认值,不等于 0——想关闭自动回收要显式写 0。
# MOCODE_CU_CAPTURE_IDLE_MS=180000
# MOCODE_CU_INJECTOR_IDLE_MS=180000
#
# ===== 视觉历史滑动窗口(抑制图像 token 二次增长)=====
# 屏幕帧目前永驻 history,而每次请求都要重发整个 history → 图像 token 二次增长
# (1568×882 ≈1843 tk/张:20 步 ≈387k、50 步 ≈2.35M),长 GUI 任务必然中途 compact,
# 而 compact 把视觉历史摘要成文本 → 模型忘了点过哪,表现为重复点击 / 点错目标。
#
# MOCODE_CU_VISION_KEEP:窗口保留最近多少条屏幕帧。默认 6。**0 = 完全关闭窗口**(回退到现状)。
# MOCODE_CU_VISION_BATCH:一次淘汰多少条。默认 4。设 1 = 严格窗口。
#
# 只作用于**屏幕帧**(`computer-*.png`):read_file 读的文档图、screenshot 工具的图、
# 用户粘贴的图都不在窗口内 —— 那些剪掉是净损失。被剪的帧会留一行可读占位
# (`[screenshot omitted: computer-result.png · step 12]`),不是裸 [omitted]。
#
# batch 是 token 与 prompt cache 的权衡:两次淘汰之间 history 前缀字节完全不变,
# batch 越大 → 前缀命中窗口越长、命中率越高,代价是在途多留几张图。
#   - 显式 prompt cache(Anthropic cache_control 断点):batch 6-8
#   - 隐式前缀缓存(DeepSeek / GLM / Qwen 自动缓存):batch 4(默认)
#   - 实测无前缀收益:batch 1
#
# 注意:清空变量(留空串)等于用默认值,不等于 0 —— 想关闭窗口要显式写 0。
# MOCODE_CU_VISION_KEEP=6
# MOCODE_CU_VISION_BATCH=4

# ===== 联网搜索(AnySearch,可选)=====
# 不配 ANYSEARCH_API_KEY 也能用:走匿名模式(按 IP 限流 + 每日免费额度)。
# 配了 key 用付费额度、更高并发;key 非法会直接 401(不降级匿名)。
# 控制台创建 key:https://www.anysearch.com/console/api-keys
# ANYSEARCH_API_KEY=your-anysearch-key
# ANYSEARCH_BASE_URL=https://api.anysearch.com
#
# web_fetch 的纯文本代理回退(**默认关**)。设为前缀型代理(如 https://r.jina.ai/)后,
# 仅当直连被反爬盾拦截(403/405/406/429/451/503)才改走 `${PROXY}${原URL}` 再试一次;
# 成功结果会标注 via proxy。默认关的理由:把目标 URL 交给第三方是隐私/信任决策,
# 必须由用户显式打开 —— agent 不能替用户把浏览足迹外包出去。
# MOCODE_WEB_FETCH_PROXY=https://r.jina.ai/

# ===== Shell 选择(run_command / dev_server,可选)=====
# 两个工具都接受逐调用参数 shell=cmd|powershell|bash;本变量改的是**全局默认值**。
# 缺省行为与旧版一致:Windows 上 cmd.exe,macOS/Linux 上 bash —— 不静默翻转默认解释器,
# 现有 prompt / skill / codegraph 的 .cmd 调用不受影响。
# Windows 上想用 POSIX 语法($VAR、&&、正斜杠路径)就设 bash:会自动探测 Git for Windows 的
# bash.exe,并**刻意排除 WSL 的 System32\bash.exe**(那是 Linux 发行版,路径 /mnt/f/…、
# 工具链与安全策略都不同)。探不到 Git Bash 时回落 cmd。
# MOCODE_SHELL=bash

# ===== Skills(按需加载,可选)=====
# mocode 自动扫描以下目录的 skill(每个 skill 是 <name>/SKILL.md,带 frontmatter):
#   ~/.claude/skills/、~/.mocode/skills/、<cwd>/.mocode/skills/
# 设了 SKILLS_DIRS 则覆盖默认三目录(按平台 PATH 分隔:Windows 用 ;,POSIX 用 :)。
# skill 的 description 注入系统提示,模型按需调 use_skill 工具加载正文。
# SKILLS_DIRS=C:\Users\you\.claude\skills;./.mocode/skills

# ===== 界面语言与颜色主题(可选)=====
# 支持 zh-CN / en；未设置时根据系统语言检测，运行中可用 /language 即时切换并持久化。
# shell 环境变量优先级高于配置文件。
# MOCODE_LANGUAGE=zh-CN

# ===== 输入安全网(可选)=====
# 长输入(≥2 行或 ≥120 字)误按 Enter 发送后的撤回窗口毫秒数。短输入固定 500ms;
# 长输入默认 2000ms(发现误发通常要 1-3 秒),窗口内按任意键即撤回原文回输入框。
# MOCODE_RECALL_MS=2000
# 二次确认发送:设为 long 时,长输入首次 Enter 只显示"再按一次 Enter 发送"提示,
# 窗口内第二次 Enter 才真正发送,其它键解除。默认关闭(不设置)。
# MOCODE_CONFIRM_SEND=long

# 内建主题:default(16 色原版,深底)、light(浅底终端)、solarized、gruvbox、nord。
# 运行中用 /theme 命令交互切换(选菜单或 /theme <名称>)——即时全屏重绘,并写入此文件,下次启动生效。
# 也可在此手填。shell 环境变量 MOCODE_THEME 优先级高于文件(设了则 /theme 写文件时给提示)。
# MOCODE_THEME=default

# ===== 沙箱(可选)=====
# 沙箱根目录:agent 文件操作(read_file/write_file/edit_file/glob/grep)与 run_command 的 cwd 边界。
# 默认 process.cwd()。越界路径(../、绝对外圈、符号链接出圈)被拒;memory_*/use_skill 在外圈豁免。
# run_command 的绝对路径写不被纯 JS 层挡(需 OS jailer,默认不启用);仅挡灾难命令(rm -rf / 等)。
# 优先级:--sandbox-root <path> 命令行 > SANDBOX_ROOT env > process.cwd()。
# SANDBOX_ROOT=/path/to/project

# ===== Model Context Protocol (MCP，可选) =====
# 全局总开关（默认开启）。设为 false 时不读取 MCP_SERVERS/MCP_CONFIG_PATH，也不会连接 MCP，适合临时加快启动。
# MOCODE_MCP_ENABLED=false
# MCP_SERVERS 是 JSON，支持同时挂多个本地或线上 server。敏感 token 建议用 ${ENV_VAR} 引用 shell 环境变量，
# 不要把 token 明文提交到 .env。也可将同样 JSON 放在单独文件，并设置 MCP_CONFIG_PATH=./mcp.servers.json。
# transport: stdio（本地进程）、streamable-http（现代远程 MCP，默认）、sse（旧版 HTTP+SSE）。
# 本地 stdio server 运行任意命令，远程 MCP 工具也可能产生副作用；mocode 会为每次外部工具调用弹出授权。
# includeTools 是可选的远程工具名白名单；excludeTools 是黑名单，且优先于白名单。未配置时注册服务端的全部工具。
# MCP_SERVERS={"mcpServers":{"filesystem":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."],"requestTimeoutMs":30000,"includeTools":["read_file","list_directory"],"excludeTools":["write_file"]},"github":{"transport":"streamable-http","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ${GITHUB_MCP_TOKEN}"}},"legacy":{"transport":"sse","url":"https://example.com/sse"}}}
# MCP_CONFIG_PATH=./mcp.servers.json
