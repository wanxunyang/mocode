{
  "name": "mocode-ai",
  "version": "1.4.0",
  "description": "终端编码 agent:LLM + tool-call 循环 + 流式输出(含思考)+ 16 个工具,接任意 OpenAI 兼容后端。",
  "type": "module",
  "bin": {
    "mocode": "bin/mocode.js",
    "mocode-agent-host": "bin/mocode-agent-host.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test-build.json && node --test --experimental-test-isolation=none \"dist-tests/tests/*.test.js\"",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p evals/tsconfig.json",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:smoke": "tsx evals/smoke.ts && tsx evals/coding/smoke.ts && tsx evals/work-discipline.ts",
    "eval:coding": "tsx evals/coding/runner.ts",
    "eval:coding:list": "tsx evals/coding/runner.ts --list",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cli-highlight": "^2.1.11",
    "dotenv": "^16.0.0",
    "fast-glob": "^3.0.0",
    "openai": "^4.0.0",
    "playwright": "1.62.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "8.5.13",
    "eslint": "^9.39.5",
    "fast-check": "3.23.1",
    "globals": "^15.15.0",
    "prettier": "3.6.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanxunyang/mocode.git"
  },
  "author": "wxy",
  "license": "MIT"
}
